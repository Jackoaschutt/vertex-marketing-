# --- The only credential -----------------------------------------------------
# One passcode gates the whole tool. Unset denies everyone, including you.
# Changing it logs every device out.
ADMIN_PASSCODE=

# Demand and competition data. Without it the collector returns an error rather
# than inventing a trend line.
SERPAPI_KEY=

# =============================================================================
# Shared infrastructure (used by both PropGuard and Vesper Commerce)
# =============================================================================

# Supabase. Without the URL + service-role key the commerce system runs in DEMO
# MODE: seeded in-memory data that resets on restart. The ops dashboard shows a
# persistent banner whenever that is the case.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL. Used for canonical URLs, Open Graph images, Stripe redirect
# URLs and the sitemap. Must be the real origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (shared account). The commerce checkout uses STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=sk_test_...

# =============================================================================
# PropGuard (existing trading-journal app) — unrelated to commerce
# =============================================================================
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 32-byte key (base64) used to encrypt Tradovate credentials at rest.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# =============================================================================
# Vesper Commerce
# =============================================================================

# --- Admin access -----------------------------------------------------------
# Comma-separated allowlist of email addresses permitted to reach /ops.
# REQUIRED. An empty value denies EVERYONE by design — a misconfigured
# deployment must never expose the admin.

# --- Payments ---------------------------------------------------------------
# Signing secret for the COMMERCE webhook endpoint. Deliberately separate from
# STRIPE_WEBHOOK_SECRET so commerce events cannot disturb PropGuard billing.
# Register the endpoint at: <your-domain>/api/commerce/webhooks/stripe
# Events needed: checkout.session.completed, charge.refunded
STRIPE_COMMERCE_WEBHOOK_SECRET=whsec_...

# --- Store configuration ----------------------------------------------------
# ISO currency code used for display and Stripe checkout.
COMMERCE_CURRENCY=USD

# Contact details shown on the storefront and used as the email sender.
COMMERCE_SUPPORT_EMAIL=support@example.com
COMMERCE_FROM_EMAIL=orders@example.com

# Social links. Leave empty to hide the link rather than render a dead one.
COMMERCE_INSTAGRAM=
COMMERCE_TIKTOK=

# --- AI (product copy + business analyst) -----------------------------------
# Without a key both fall back to deterministic generators, clearly badged in
# the UI as FALLBACK. They are never passed off as model output.
ANTHROPIC_API_KEY=
COMMERCE_AI_MODEL=claude-opus-5

# --- Transactional email ----------------------------------------------------
# Without a key the console transport is used: emails are rendered and logged
# but never delivered. Customers will not receive order confirmations.
RESEND_API_KEY=

# --- Suppliers --------------------------------------------------------------
# CJdropshipping. The adapter is written to the published Developer API v2 but
# has NOT been verified against a live account — place one test order before
# routing customer orders through it.
CJ_EMAIL=
CJ_API_KEY=
# Override only if CJ moves the API base URL.
CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1

# Shared secret for inbound supplier webhooks (HMAC-SHA256 over the raw body,
# sent as the x-supplier-signature header). Without it the endpoint rejects
# everything — it never falls back to accepting unsigned input.
# Generate with: openssl rand -hex 32
SUPPLIER_WEBHOOK_SECRET=

# Generic HTTP supplier adapter: name the env var holding the token in
# ds_suppliers.config.tokenEnv, then define it here. Example:
# EXAMPLE_SUPPLIER_TOKEN=

# --- Scheduled automations --------------------------------------------------
# Bearer token accepted by POST /api/commerce/automations/run so any scheduler
# (Vercel Cron, GitHub Actions, external cron) can trigger the jobs.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Meta Ads (IMPLEMENTED) -------------------------------------------------
# Reads daily insights into ds_ad_metrics and can create campaigns (always
# PAUSED). Without these, ad spend is entered manually in /ops/marketing —
# those figures are just as real, they just are not automatic.
#
# Token: a long-lived System User token from Meta Business Settings.
#   Scopes: ads_read (import) and ads_management (create campaigns).
# Verify everything with GET /api/commerce/marketing/meta/status before
# importing or spending — it round-trips the Graph API and reports the account
# name, currency, timezone and spend status.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
# Only needed to CREATE campaigns; importing performance does not use it.
META_PAGE_ID=
# Graph API version. Meta supports each version for roughly two years; check
# https://developers.facebook.com/docs/graph-api/changelog and set this to a
# version your app supports. An expired version produces an "Unsupported get
# request" error, which the status endpoint detects and explains.
META_API_VERSION=v23.0
# Graph API host override. Only for testing against a mock or routing through an
# egress proxy — leave unset in production.
# META_GRAPH_BASE=

# --- Other ad platforms (NOT IMPLEMENTED) -----------------------------------
# The metric schema, storage and profit engine are ready; implement
# AdChannelClient in lib/commerce/marketing/ and register it in channels.ts.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=

# =============================================================================
# server.py — the separate Python MCP discovery server (optional)
# =============================================================================
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
SERPAPI_KEY=
