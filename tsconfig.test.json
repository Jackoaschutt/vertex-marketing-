{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "incremental": false,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["lib/commerce/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", ".next", "**/*.tsx"]
}
